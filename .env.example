BOT_TOKEN=123456:your-telegram-bot-token
# HTTPS URL of the mini app (Telegram requires https). Leave empty locally —
# the bot then skips the mini app server and menu button.
WEBAPP_URL=https://your-domain-or-nip-io-address/
# PIN for the hidden /admin mini-app panel (second factor on top of the
# Telegram identity check). Keep this only in .env — never in training.yaml,
# the repo is public.
ADMIN_PIN=000000
