BOT_TOKEN=123456:your-telegram-bot-token
# HTTPS URL of the mini app (Telegram requires https). Leave empty locally —
# the bot then skips the mini app server and menu button.
WEBAPP_URL=https://your-domain-or-nip-io-address/
# PIN for the hidden /admin mini-app panel (second factor on top of the
# Telegram identity check). Keep this only in .env — never in training.yaml,
# the repo is public.
ADMIN_PIN=000000

# --- Тренажёр звонка (GigaChat). Без ключа тренажёр честно пишет, что
# --- собеседник недоступен, остальные вкладки работают как обычно.
# Ключ авторизации из личного кабинета (строка Base64), НЕ client secret
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — физлицо, GIGACHAT_API_B2B — платный пакет, GIGACHAT_API_CORP — постоплата
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Путь к корневому сертификату НУЦ Минцифры, если системе он неизвестен
GIGACHAT_CA_BUNDLE=
# Крайняя мера, если сертификат поставить некуда: 0 отключает проверку TLS
GIGACHAT_VERIFY_SSL=1
